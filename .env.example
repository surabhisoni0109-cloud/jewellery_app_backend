# Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control!

# Server & Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Production example: APP_URL=https://api.yourdomain.com

# PostgreSQL Database Connection
# Postgres is running locally on port 5432 and jewellery_db exists
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jewellery_db?schema=public

# Redis Connection (supports redis:// or rediss://)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# OTP Configuration
OTP_HMAC_SECRET=super_secret_otp_hmac_key_change_in_production
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_HOURLY_LIMIT=5

# SMS Provider Configuration (console | msg91 | twilio)
SMS_PROVIDER=console

# Development Flags
# Set to true to expose devOtp in signup and signin API responses (development only!)
EXPOSE_OTP_IN_RESPONSE=true
# Set to true to enable Swagger documentation UI in production environments
SWAGGER_ENABLED=true

# MSG91 Provider Credentials (Optional)
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_msg91_template_id

# Twilio Provider Credentials (Optional)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# AWS S3 File Storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name
